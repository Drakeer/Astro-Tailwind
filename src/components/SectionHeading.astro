---
interface Props {
  index: string;
  command: string;
  title: string;
}

const { index, command, title } = Astro.props;
---

<div class="reveal mb-10 sm:mb-14">
  <div class="flex items-center gap-3 font-mono text-xs sm:text-sm">
    <span class="text-ink-faint tabular-nums">{index}</span>
    <span class="text-accent-deep">$</span>
    <span class="text-ink-dim">{command}</span>
    <span
      class="h-px flex-1 bg-gradient-to-r from-edge-lit to-transparent"
      aria-hidden="true"></span>
  </div>

  <h2
    class="mt-4 font-mono text-2xl font-semibold tracking-tight text-ink sm:text-3xl"
  >
    {title}
  </h2>
</div>
